<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" style="-fx-background-color: #E8D6FF;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lester.carrentalsystem.Controller.Client.TransactionController">
   <children>
      <VBox layoutX="112.0" layoutY="38.0" prefHeight="400.0" prefWidth="247.0" spacing="10.0">
         <children>
            <Label text="Car">
               <font>
                  <Font name="Arial Bold" size="17.0" />
               </font>
            </Label>
            <!-- Pre-populated car name (not editable) -->
            <TextField fx:id="carNameField" editable="false" style="-fx-border-color: #d493f5;" />

            <Label text="Rent Start Date">
               <font>
                  <Font name="Arial" size="17.0" />
               </font>
            </Label>
            <DatePicker fx:id="rentStartDatePicker" style="-fx-border-color: #d493f5;" />

            <Label text="Rent End Date">
               <font>
                  <Font name="Arial" size="17.0" />
               </font>
            </Label>
            <DatePicker fx:id="rentEndDatePicker" style="-fx-border-color: #d493f5;" />

            <Label text="Pick Off Location">
               <font>
                  <Font name="Arial" size="17.0" />
               </font>
            </Label>
            <TextField fx:id="pickOffLocationField" style="-fx-border-color: #d493f5;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </TextField>

            <Label text="Payment Method">
               <font>
                  <Font name="Arial" size="17.0" />
               </font>
            </Label>
            <ComboBox fx:id="paymentMethodComboBox" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #d493f5;" />

            <Label text="Price">
               <font>
                  <Font name="Arial" size="17.0" />
               </font>
            </Label>
            <!-- Non-editable field for price -->
            <TextField fx:id="rentPriceField" editable="false" style="-fx-border-color: #d493f5;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </TextField>

            <Button mnemonicParsing="false" onAction="#onConfirmRentClicked" style="-fx-background-color: white; -fx-border-color: #d493f5;" text="Confirm Rent">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
