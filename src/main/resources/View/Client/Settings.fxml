<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="720.0" prefWidth="830.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lester.carrentalsystem.Controller.Client.SettingsController">
    <children>
        <Label text="Client ID:" layoutX="30.0" layoutY="20.0" />
        <TextField fx:id="clientIdField" layoutX="150.0" layoutY="20.0" editable="false" />

        <Label text="Full Name:" layoutX="30.0" layoutY="70.0" />
        <TextField fx:id="fullNameField" layoutX="150.0" layoutY="70.0" />

        <Label text="Username:" layoutX="30.0" layoutY="120.0" />
        <TextField fx:id="usernameField" layoutX="150.0" layoutY="120.0" />

        <Label text="Password:" layoutX="30.0" layoutY="170.0" />
        <TextField fx:id="passwordField" layoutX="150.0" layoutY="170.0" />

        <Label text="Contact Number:" layoutX="30.0" layoutY="220.0" />
        <TextField fx:id="contactNumberField" layoutX="150.0" layoutY="220.0" />

        <Label text="Profile Picture:" layoutX="30.0" layoutY="270.0" />
        <ImageView fx:id="profilePictureView" layoutX="150.0" layoutY="270.0" fitWidth="150.0" fitHeight="150.0" />

        <Button fx:id="uploadProfilePictureButton" text="Change Profile Picture" layoutX="150.0" layoutY="430.0" onAction="#onChangeProfilePictureClicked" />

        <Label text="Driver's License:" layoutX="30.0" layoutY="480.0" />
        <ImageView fx:id="driversLicenseView" layoutX="150.0" layoutY="480.0" fitWidth="150.0" fitHeight="150.0" />

        <Button fx:id="uploadDriversLicenseButton" text="Change Driver's License" layoutX="150.0" layoutY="640.0" onAction="#onChangeDriversLicenseClicked" />

        <Button fx:id="saveButton" text="Save Changes" layoutX="350.0" layoutY="680.0" onAction="#onSaveChangesClicked" />
    </children>
</AnchorPane>
