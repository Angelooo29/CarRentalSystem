<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="photoArea" prefHeight="720.0" prefWidth="830.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lester.carrentalsystem.Controller.Client.HomeController">
   <ImageView fitHeight="720.0" fitWidth="830.0" layoutY="8.0" pickOnBounds="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <image>
         <Image url="@../../Images/MainPhoto.png" />
      </image>
   </ImageView>
   <Button fx:id="previousButton" layoutX="150.0" layoutY="500.0" onAction="#onPreviousButtonClicked" text="Previous" />
   <Button fx:id="nextButton" layoutX="550.0" layoutY="500.0" onAction="#onNextButtonClicked" text="Next" />
</AnchorPane>
