                  <Font name="Segoe UI Bold" size="24.0" />
               </font>
            </Label>
            <TextField fx:id="usernameField" layoutX="73.0" layoutY="164.0" maxWidth="350.0" prefHeight="50.0" prefWidth="350.0" style="-fx-border-color: #531F72;">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </TextField>
            <PasswordField fx:id="passwordField" layoutX="73.0" layoutY="256.0" maxWidth="350.0" prefHeight="50.0" prefWidth="350.0" style="-fx-border-color: #531F72;">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </PasswordField>
            <TextField fx:id="visiblePasswordField" layoutX="73.0" layoutY="256.0" maxWidth="350.0" prefHeight="50.0" prefWidth="350.0" style="-fx-border-color: #531F72;">
