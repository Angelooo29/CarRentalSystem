            </TextField>
            <Button fx:id="loginButton" layoutX="173.0" layoutY="368.0" maxWidth="300.0" mnemonicParsing="false" onAction="#onLoginButtonClicked" prefHeight="50.0" prefWidth="155.0" style="-fx-background-color: #531F72;" text="LOGIN" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="18.0" />
               </font>
            </Button>
            <Label layoutX="74.0" layoutY="137.0" text="Username:" textFill="#531f72">
