<AnchorPane maxHeight="500.0" maxWidth="800.0" minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0" style="-fx-border-color: #531F72; -fx-border-width: 3;" stylesheets="@../Style/Style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lester.carrentalsystem.Controller.LoginController">
   <children>
      <AnchorPane layoutX="585.0" layoutY="21.0" prefHeight="500.0" prefWidth="500.0" style="-fx-background-color: #ffffff;" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label layoutX="97.0" layoutY="60.0" text="LOGIN TO YOUR ACCOUNT" textFill="#531f72">
